#!/usr/bin/env bash
# Displays DNS A record info for a domain's subdomains.

get_subdomain_info() {
    local domain="$1"
    local subdomain="$2"
    local full_domain="${subdomain}.${domain}"
    local record_type
    local destination

    read -r record_type destination < <(dig "$full_domain" | awk '/ANSWER SECTION:/{getline; print $4, $5}')

    echo "The subdomain ${subdomain} is a ${record_type} record and points to ${destination}"
}

domain="$1"
subdomain="$2"

if [ -n "$subdomain" ]; then
    get_subdomain_info "$domain" "$subdomain"
else
    for sub in www lb-01 web-01 web-02; do
        get_subdomain_info "$domain" "$sub"
    done
fi
